# Copy to supabase/.env for local Edge Function development. Never commit real values.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REDIRECT_URI=http://127.0.0.1:55321/functions/v1/gmail-oauth-callback
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_TOKEN_ENCRYPTION_KEY_VERSION=1
HEXFORGE_WEB_ORIGINS=http://localhost:5175,http://127.0.0.1:5175
# Optional additional loopback origins; production origins remain provider configuration.
HEXFORGE_LOCAL_WEB_ORIGINS=
# Booking identity validation for collection and profile-access functions.
BOOKINGS_SUPABASE_URL=
BOOKINGS_SUPABASE_ANON_KEY=
# Public viewer destination used by server-generated project links.
STUDENT_VIEW_URL=
