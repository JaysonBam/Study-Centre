{
  "name": "@hexforge/windows-helper",
  "productName": "HexForge File Helper",
  "description": "Secure local-file companion for HexForge",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "main": "dist/src/main/app/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "node scripts/build.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "package": "npm run build && node --import tsx scripts/packageHelper.ts",
    "smoke": "node --import tsx scripts/smokeHelper.ts"
  },
  "devDependencies": {
    "@types/node": "24.10.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "tsx": "4.23.1",
    "typescript": "5.9.3",
    "esbuild": "0.27.2"
  },
  "dependencies": {
    "@study-centre/contracts": "*"
  }
}
