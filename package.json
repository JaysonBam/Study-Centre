{
  "name": "misc-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "node scripts/lint.mjs",
    "test": "npm run build:contracts && npm run test:tools && npm run test --workspaces --if-present",
    "dev:bookings": "npm run dev --workspace apps/bookings",
    "build:bookings": "npm run build --workspace apps/bookings",
    "typecheck:bookings": "npm run typecheck --workspace apps/bookings",
    "lint:bookings": "npm run lint --workspace apps/bookings",
    "test:bookings": "npm run test --workspace apps/bookings",
    "dev:availability": "npm run dev --workspace apps/availability",
    "build:availability": "npm run build --workspace apps/availability",
    "typecheck:availability": "npm run typecheck --workspace apps/availability",
    "lint:availability": "npm run lint --workspace apps/availability",
    "test:availability": "npm run lint:availability && npm run typecheck:availability",
    "dev:hexforge": "npm run dev --workspace apps/hexforge",
    "build:hexforge": "npm run build --workspace apps/hexforge",
    "typecheck:hexforge": "npm run typecheck --workspace apps/hexforge",
    "lint:hexforge": "npm run lint --workspace apps/hexforge",
    "test:hexforge": "npm run build:contracts && npm run test --workspace apps/hexforge",
    "dev:printing-status": "npm run dev --workspace apps/printing-status",
    "build:printing-status": "npm run build --workspace apps/printing-status",
    "typecheck:printing-status": "npm run typecheck --workspace apps/printing-status",
    "lint:printing-status": "npm run lint --workspace apps/printing-status",
    "test:printing-status": "npm run test --workspace apps/printing-status",
    "dev:helper": "npm run build:contracts && npm run dev --workspace apps/windows-helper",
    "build:helper": "npm run build:contracts && npm run build --workspace apps/windows-helper",
    "test:helper": "npm run build:contracts && npm run test --workspace apps/windows-helper",
    "package:helper": "npm run build:contracts && npm run package --workspace apps/windows-helper",
    "smoke:helper": "npm run smoke --workspace apps/windows-helper",
    "test:performance": "npm run test:performance --workspace apps/hexforge",
    "test:browser": "npm run test:browser --workspace apps/bookings",
    "check": "npm run check:public && npm run check:architecture && npm run format:check && npm run typecheck && npm test && npm run test:performance && npm run lint && npm run build",
    "check:public": "node scripts/check-public.mjs",
    "test:tools": "node --test scripts/*.test.mjs",
    "lint:strict": "npm run lint --workspaces --if-present",
    "build:contracts": "npm run build --workspace @study-centre/contracts",
    "check:architecture": "node scripts/check-architecture.mjs",
    "format": "prettier --write \"apps/*/src/**/*.{ts,tsx,cts}\" \"packages/*/src/**/*.ts\" \"apps/*/scripts/**/*.ts\" \"scripts/*.mjs\" \"apps/*/vite.config.ts\"",
    "format:check": "prettier --check \"apps/*/src/**/*.{ts,tsx,cts}\" \"packages/*/src/**/*.ts\" \"apps/*/scripts/**/*.ts\" \"scripts/*.mjs\" \"apps/*/vite.config.ts\""
  },
  "devDependencies": {
    "prettier": "3.9.10",
    "supabase": "2.84.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "@tiptap/core": "3.26.0",
    "@tiptap/extension-blockquote": "3.26.0",
    "@tiptap/extension-bold": "3.26.0",
    "@tiptap/extension-bubble-menu": "3.26.0",
    "@tiptap/extension-bullet-list": "3.26.0",
    "@tiptap/extension-code": "3.26.0",
    "@tiptap/extension-code-block": "3.26.0",
    "@tiptap/extension-color": "3.26.0",
    "@tiptap/extension-document": "3.26.0",
    "@tiptap/extension-dropcursor": "3.26.0",
    "@tiptap/extension-floating-menu": "3.26.0",
    "@tiptap/extension-font-family": "3.26.0",
    "@tiptap/extension-gapcursor": "3.26.0",
    "@tiptap/extension-hard-break": "3.26.0",
    "@tiptap/extension-heading": "3.26.0",
    "@tiptap/extension-highlight": "3.26.0",
    "@tiptap/extension-horizontal-rule": "3.26.0",
    "@tiptap/extension-image": "3.26.0",
    "@tiptap/extension-italic": "3.26.0",
    "@tiptap/extension-link": "3.26.0",
    "@tiptap/extension-list": "3.26.0",
    "@tiptap/extension-list-item": "3.26.0",
    "@tiptap/extension-list-keymap": "3.26.0",
    "@tiptap/extension-ordered-list": "3.26.0",
    "@tiptap/extension-paragraph": "3.26.0",
    "@tiptap/extension-strike": "3.26.0",
    "@tiptap/extension-text": "3.26.0",
    "@tiptap/extension-text-style": "3.26.0",
    "@tiptap/extension-underline": "3.26.0",
    "@tiptap/extensions": "3.26.0",
    "@tiptap/pm": "3.26.0",
    "@tiptap/react": "3.26.0",
    "@tiptap/starter-kit": "3.26.0"
  }
}
